# install.packages("drc")   # run once if needed
library(drc)
y <- c(10.39, 15.98, 27.56, 53.26, 68.83, 83.85, 99.68, 102.22)
# x as typed into the spreadsheet (rounded to 2 decimals)
x_typed <- c(10.87, 5.43, 2.72, 1.36, 0.68, 0.34, 0.17, 0.08)
# x as n2dr computes it internally, at full precision
# formula: ((dose * stock) / 200) * 10 * 0.5^(0:7) / well.vol * 1000
x_exact <- (((20 * 2.5) / 200) * 10 * 0.5^(0:7) / 230) * 1000
fit_it <- function(x, y, label) {
d <- data.frame(x = x, y = y)
m <- drm(y ~ x, data = d,
fct = LL.4(names = c("Slope", "min", "max", "EC50")))
cat("\n========", label, "========\n")
print(coef(summary(m)))
cat("Residual sum of squares:", round(sum(residuals(m)^2), 4), "\n")
invisible(m)
}
m_typed <- fit_it(x_typed, y, "rounded x  (what went into SigmaPlot)")
m_exact <- fit_it(x_exact, y, "exact x    (what n2dr uses)")
# side by side
cat("\n---- EC50 comparison ----\n")
print(data.frame(
source = c("drc, rounded x", "drc, exact x"),
EC50   = c(coef(m_typed)["EC50:(Intercept)"],
coef(m_exact)["EC50:(Intercept)"])
), row.names = FALSE)
cat("\nx values compared:\n")
print(data.frame(typed = x_typed, exact = round(x_exact, 4)))
n2dr(dat, 2.5, 20, subset=1)
